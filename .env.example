# Public — safe to expose to the browser (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SITE_URL=https://dbmind.ai

# Server-side — leads API / CRM
LEADS_API_URL=
CRM_PROVIDER=none          # e.g. "hubspot" | "salesforce" | "none" (in-memory prototype)
CRM_API_KEY=

# Server-side — email notifications
EMAIL_PROVIDER=none        # e.g. "resend" | "sendgrid" | "none"
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Analytics — only initialized client-side after analytics consent is granted
NEXT_PUBLIC_ANALYTICS_PROVIDER=none   # e.g. "plausible" | "ga4" | "none"
NEXT_PUBLIC_ANALYTICS_ID=

# Marketing — only initialized client-side after marketing consent is granted
NEXT_PUBLIC_MARKETING_PROVIDER=none
NEXT_PUBLIC_MARKETING_ID=

# Scheduling (consultation booking card)
NEXT_PUBLIC_SCHEDULING_PROVIDER=none  # e.g. "calendly" | "savvycal" | "none"
NEXT_PUBLIC_SCHEDULING_URL=
